<ul class="<%= it.nested ? 'ml-4 border-l-2 border-zinc-200 pl-3' : 'divide-y divide-zinc-200' %>">
<% for (const crate of it.crates) { %>
<li data-id="<%= crate.id %>" data-name="<%= crate.label %>" class="<%= it.nested ? 'border-t border-zinc-100' : '' %>">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 hover:bg-zinc-50">
    <div class="min-w-0 flex-1 basis-64">
      <p class="crate-name font-medium"><%= crate.label %></p>
      <p><code class="block truncate font-mono text-xs text-zinc-500" title="<%= crate.id %>"><%= crate.id %></code></p>
    </div>
    <div class="flex gap-2 text-xs">
<% for (const state of crate.states) { %>
      <span class="index-state inline-flex items-center gap-1 rounded-full px-2 py-0.5 whitespace-nowrap <%= state.value === 'indexed' ? 'bg-emerald-100 text-emerald-800' : state.value === 'not indexed' ? 'bg-zinc-100 text-zinc-600' : 'animate-pulse bg-amber-100 text-amber-900' %>"><span class="font-medium"><%= state.label %>:</span> <%= state.value %></span>
<% } %>
    </div>
    <div class="crate-actions flex gap-2 sm:w-40 sm:justify-end">
<% for (const form of crate.actions) { %>
      <%~ include('./action-form', { form }) %>
<% } %>
    </div>
  </div>
<% if (crate.children.length > 0) { %>
  <%~ include('./crate-list', { crates: crate.children, nested: true }) %>
<% } %>
</li>
<% } %>
</ul>
