<form method="post" action="<%= it.adminPath %>/<%= it.form.action %>" class="inline"<% if (it.form.confirm) { %> data-confirm="<%= it.form.confirm %>"<% } %>><% if (it.form.crateId) { %><input type="hidden" name="crateId" value="<%= it.form.crateId %>"><% } %><% if (it.form.force) { %><input type="hidden" name="force" value="true"><% } %><button type="submit" class="cursor-pointer rounded border px-2 py-0.5 text-sm bg-white <%= it.form.action === 'delete' ? 'border-red-300 text-red-700 hover:bg-red-50' : 'border-zinc-300 hover:border-amber-500 hover:bg-amber-50' %>"><%= it.form.label %></button></form>
