<!DOCTYPE html>
<html lang="en" class="bg-zinc-100 text-zinc-900 antialiased">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= it.title %> · LDaCA admin</title>
  <link rel="stylesheet" href="<%= it.adminPath %>/admin.css">
  <script src="<%= it.adminPath %>/admin.js" defer></script>
<% if (it.refresh) { %>
  <meta http-equiv="refresh" content="<%= it.refresh %>">
<% } %>
</head>
<body class="min-h-screen font-sans">
  <header class="border-b-4 border-amber-400 bg-zinc-900 text-zinc-100">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-3">
      <p class="flex items-center gap-3 font-semibold tracking-wide">
        LDaCA
        <span class="rounded bg-amber-400 px-2 py-0.5 font-mono text-xs font-bold uppercase tracking-widest text-zinc-900">Admin</span>
      </p>
<% if (it.user) { %>
      <div class="flex items-center gap-4 text-sm">
        <p class="text-zinc-400">Signed in as <span class="font-medium text-zinc-100"><%= it.user %></span></p>
        <form method="post" action="<%= it.adminPath %>/sign-out"><button type="submit" class="cursor-pointer rounded border border-zinc-600 px-3 py-1 hover:border-amber-400 hover:text-amber-400">Sign out</button></form>
      </div>
<% } %>
    </div>
  </header>
  <main class="mx-auto max-w-5xl px-6 py-8">
    <h1 class="mb-6 text-2xl font-bold tracking-tight"><%= it.title %></h1>
<% if (it.flash) { %>
    <p role="status" class="mb-6 rounded border px-4 py-3 <%= it.flash.accepted ? 'border-emerald-300 bg-emerald-50 text-emerald-900' : 'border-red-300 bg-red-50 text-red-900' %>"><%= it.flash.message %></p>
<% } %>
    <%~ it.body %>
  </main>
</body>
</html>
