# Copy to .env to override. Every variable is optional in development and test.
# NODE_ENV=development

# Required when NODE_ENV=production
# DATABASE_URL=postgresql://ldacapi:ldacapi@localhost:5432/ldacapi
# OPENSEARCH_URL=http://localhost:9200
# TOKEN_ADMIN=1234-1234-1234-1234
# OCFL_ROOT=storage/ocfl

# Working directory for OCFL writes. Defaults to `scratch` beside OCFL_ROOT
# OCFL_SCRATCH=storage/scratch

# LDACAPI_PORT=8080
# LDACAPI_HOST=localhost
# LDACAPI_MAX_PARAM_LENGTH=500
# LOG_LEVEL=debug
# ENTITY_INDEX=entities

# Licences applied to crates that don't declare one
# DEFAULT_LICENSE=
# DEFAULT_METADATA_LICENSE=

# REMS_USER=
# REMS_KEY=
# REMS_ENDPOINT=
# ENROLLMENT_URL=

# Sign-in is on when OIDC_UPSTREAM_ISSUER is set; the client ID and secret, and at least one client in OIDC_CLIENTS, are then required.
# Register <OIDC_ISSUER>/oauth/callback (e.g. http://localhost:8080/oauth/callback) as the redirect URI at the upstream provider
# OIDC_UPSTREAM_ISSUER=https://cilogon.org
# OIDC_UPSTREAM_CLIENT_ID=
# OIDC_UPSTREAM_CLIENT_SECRET=

# Our public origin (no path), the issuer of our tokens. Defaults to http://localhost:8080; required, and https, in production when sign-in is on
# OIDC_ISSUER=http://localhost:8080

# Clients allowed to get tokens, as a JSON array. Clients without a client_secret are public and must use PKCE
# OIDC_CLIENTS=[{"client_id":"oni","redirect_uris":["http://localhost:3000/auth/callback"],"post_logout_redirect_uris":["http://localhost:3000/"]}]

# The keys that sign our tokens (a JWKS of private RSA keys) and cookies (comma-separated, at least 32 characters each); the first of each signs.
# Required in production when sign-in is on; otherwise throwaway keys are generated at each start. Generate with `pnpm generate-keys`
# OIDC_SIGNING_KEYS='{"keys":[...]}'
# OIDC_COOKIE_KEYS=

# The `sub`s of admins, who can use the admin pages at <OIDC_ISSUER>/admin/, comma-separated. Unset means nobody
# ADMIN_USERS=
