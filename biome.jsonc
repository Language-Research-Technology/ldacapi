{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 160
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useBlockStatements": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/indexer/**"],
                "message": "Only the worker, the CLI scripts and tests run the indexer; ask for index jobs through src/index-queue/ instead."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/indexer/**", "src/worker.ts", "scripts/**", "test/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ],
  "css": { "parser": { "tailwindDirectives": true } },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
