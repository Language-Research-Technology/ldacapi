# Copy to .env (chmod 600). Docker Compose reads it to fill in compose.yaml.

# Point both names' DNS at this host. Caddy gets their certificates from Let's Encrypt.
DOMAIN=data.example.org
ADMIN_DOMAIN=admin.data.example.org
ACME_EMAIL=ops@example.org

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# The directory holding the OCFL repository (its `ocfl` directory) and scratch (`scratch`),
# e.g. an NFS mount. It must be writable by uid 1000 to import crates.
STORAGE_DIR=/mnt/ldacapi

# OpenSearch's JVM heap; about half the memory you can give it
# OPENSEARCH_HEAP=1g
