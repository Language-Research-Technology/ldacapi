# Copy to .env (chmod 600). Docker Compose reads it to fill in compose.yaml.

# Point these names' DNS, and downloader.<DOMAIN>'s for the Downloader, at this host. Caddy gets
# their certificates from Let's Encrypt.
DOMAIN=data.example.org
ADMIN_DOMAIN=admin.data.example.org
ACME_EMAIL=ops@example.org

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
# The Downloader's secret at the API's sign-in, and its key to the zips' bucket
DOWNLOADER_CLIENT_SECRET=
DOWNLOADER_S3_SECRET=

# The OCFL repository, e.g. on an NFS mount. It must exist (empty for a new repository) and be
# writable by uid 1000 to import crates.
OCFL_DIR=/mnt/ldacapi/ocfl

# Where the Downloader's zips are kept for two days, e.g. on an NFS mount. It must hold `buckets` and
# `meta`, owned by uid 1000.
DOWNLOADS_DIR=/mnt/ldacapi/downloads

# OpenSearch's JVM heap; about half the memory you can give it
# OPENSEARCH_HEAP=1g
