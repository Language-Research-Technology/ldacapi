# Copy to ldacapi.env (chmod 600). The API's configuration; see the README's Configuration section.
# compose.yaml sets the database, OpenSearch, storage, OIDC_ISSUER, ADMIN_ORIGIN and Oni's client.
# Don't quote values: Docker keeps the quotes.

# Sign-in at the upstream provider. Register https://<DOMAIN>/oauth/callback as the redirect URI there.
OIDC_UPSTREAM_ISSUER=https://cilogon.org
OIDC_UPSTREAM_CLIENT_ID=
OIDC_UPSTREAM_CLIENT_SECRET=

# Append these with: docker compose run --rm --no-deps api pnpm -s generate-keys >> ldacapi.env
# OIDC_SIGNING_KEYS=
# OIDC_COOKIE_KEYS=

# The `sub`s of the admins, comma-separated
ADMIN_USERS=

# Licences applied to crates that don't declare one
# DEFAULT_LICENSE=
# DEFAULT_METADATA_LICENSE=

# REMS_USER=
# REMS_KEY=
# REMS_ENDPOINT=
# ENROLLMENT_URL=

# LOG_LEVEL=info
