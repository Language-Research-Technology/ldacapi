# Copy to ldacapi.env (chmod 600). The API's configuration; see the README's Configuration section.
# compose.yaml sets the database, OpenSearch, storage, OIDC_ISSUER, ADMIN_ORIGIN and Oni's client.
# Don't quote values: Docker keeps the quotes.

# Sign-in at the upstream provider. Register https://<DOMAIN>/oauth/callback as the redirect URI there.
OIDC_UPSTREAM_ISSUER=https://cilogon.org
OIDC_UPSTREAM_CLIENT_ID=
OIDC_UPSTREAM_CLIENT_SECRET=

# Append these with: docker compose run --rm --no-deps api pnpm -s generate-keys >> ldacapi.env
# OIDC_SIGNING_KEYS=
# OIDC_COOKIE_KEYS=

# The `sub`s of the admins, comma-separated
ADMIN_USERS=

# Required. Licence ids anyone may read, signed in or not, comma-separated; any other licence needs an entitlement in REMS
OPEN_LICENSES=https://creativecommons.org/licenses/by/3.0/au/,https://creativecommons.org/licenses/by/4.0/,https://creativecommons.org/licenses/by-nc/4.0/,https://creativecommons.org/licenses/by-nd/3.0/au/,https://creativecommons.org/licenses/by-nc-nd/4.0/

# Content licence for crates whose root dataset has none
# DEFAULT_LICENSE=
# Metadata licence for crates whose ro-crate-metadata.json has none. Production needs it: most crates have no metadata licence
# DEFAULT_METADATA_LICENSE=

# REMS_USER=
# REMS_KEY=
# REMS_ENDPOINT=
# Where users apply for a licence; {licenseId} is replaced by the URL-encoded licence id
# ENROLLMENT_URL=https://rems.example.org/apply-for?resource={licenseId}

# LOG_LEVEL=info
