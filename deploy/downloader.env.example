# Copy to downloader.env (chmod 600). The Downloader's own settings; compose.yaml sets the API,
# sign-in and the zips' bucket. Don't quote values: Docker keeps the quotes.

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# The emails with the download links: their sender, and the SMTP server that sends them.
# smtp:// uses STARTTLS, smtps:// TLS from the start; leave out user:pass@ for a relay that allows
# this host by address, and percent-encode @ and other special characters in them.
EMAIL_FROM=
SMTP_URL=smtp://user:pass@relay.example.org:587

# SENTRY_DSN=
