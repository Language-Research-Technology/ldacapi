# Copy to downloader.env (chmod 600). The downloader's own settings; compose.yaml sets the API and sign-in.
# See the README's Downloader section for the AWS setup. Don't quote values: Docker keeps the quotes.

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Zips are uploaded here and linked from the email for 24 hours
AWS_REGION=ap-southeast-2
S3_BUCKET=
# A sender SES has verified
EMAIL_FROM=

# An IAM user limited to the bucket and sending email
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SENTRY_DSN=
