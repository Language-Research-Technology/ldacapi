{
  "name": "ldacapi",
  "version": "1.0.0",
  "description": "Implementation of Arocapi for Language Data Commons - REST API using TypeScript, Fastify, and Prisma",
  "main": "src/index.ts",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "test": "NODE_ENV=test prisma migrate reset -f && vitest run",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:console:bash": "docker compose exec db bash",
    "db:console": "docker compose exec db psql -U ldacapi -d ldacapi",
    "lint:biome": "biome check",
    "lint:knip": "knip",
    "lint:tsc": "tsc",
    "lint": "pnpm run --parallel /^lint:/"
  },
  "author": "",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "@fastify/bearer-auth": "^10.1.3",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/routes": "^6.0.3",
    "@fastify/sensible": "^6.0.6",
    "@ocfl/ocfl": "^0.4.0",
    "@ocfl/ocfl-fs": "^0.4.0",
    "@opensearch-project/opensearch": "^3.9.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "arocapi": "^4.0.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "hash-wasm": "^4.12.0",
    "ro-crate": "^3.7.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.19.1",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
