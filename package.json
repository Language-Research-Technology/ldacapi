{
  "name": "ldacapi",
  "version": "1.0.0",
  "private": true,
  "description": "Implementation of Arocapi for Language Data Commons - REST API using TypeScript, Fastify, and Prisma",
  "homepage": "https://github.com/Language-Research-Technology/ldacapi#readme",
  "bugs": {
    "url": "https://github.com/Language-Research-Technology/ldacapi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Language-Research-Technology/ldacapi.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "postinstall": "prisma generate",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "tailwindcss -i src/admin/admin.css -o src/admin/public/admin.css --minify",
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:api": "node --env-file-if-exists=.env --watch src/index.ts",
    "dev:worker": "node --env-file-if-exists=.env --max-old-space-size=768 --watch src/worker.ts",
    "dev:css": "tailwindcss -i src/admin/admin.css -o src/admin/public/admin.css --watch=always",
    "ocfl:init": "node --env-file-if-exists=.env scripts/ocfl-init.ts",
    "crates:import": "node --env-file-if-exists=.env --max-old-space-size=768 scripts/crates-import.ts",
    "index": "node --env-file-if-exists=.env --max-old-space-size=768 scripts/index.ts",
    "worker": "node --env-file-if-exists=.env --max-old-space-size=768 src/worker.ts",
    "bootstrap": "pnpm db:deploy && pnpm crates:import --mode sync",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:console:bash": "docker compose exec db bash",
    "db:console": "docker compose exec db psql -U ldacapi -d ldacapi",
    "lint:biome": "biome check",
    "lint:knip": "knip",
    "lint:tsc": "tsc",
    "lint": "pnpm run --parallel /^lint:/",
    "generate-keys": "node scripts/generate-keys.ts"
  },
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.23.0",
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/formbody": "^9.0.2",
    "@fastify/secure-session": "^8.4.2",
    "@fastify/sensible": "^6.0.8",
    "@fastify/static": "^10.1.12",
    "@fastify/view": "^12.0.1",
    "@ocfl/ocfl-fs": "1.0.0-beta.68",
    "@opensearch-project/opensearch": "^3.10.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "arocapi": "5.0.0-beta.13",
    "eta": "^4.6.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "oidc-provider": "^9.15.1",
    "openid-client": "^6.9.1",
    "pino": "^10.4.0",
    "prisma": "^7.10.1",
    "ro-crate": "^3.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/oidc-provider": "^9.13.1",
    "@vitest/coverage-v8": "^5.1.1",
    "knip": "^6.48.0",
    "lefthook": "^2.2.2",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
