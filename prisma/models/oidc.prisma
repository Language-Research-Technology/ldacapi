/// One oidc-provider model instance (Session, Grant, AuthorizationCode, …)
model OidcPayload {
  model      String
  id         String

  payload    Json
  grantId    String?
  uid        String?
  expiresAt  DateTime?
  consumedAt DateTime?

  @@id([model, id])
  @@index([grantId])
  @@index([expiresAt])
  @@index([model, uid])
  @@map("oidc_payload")
}
