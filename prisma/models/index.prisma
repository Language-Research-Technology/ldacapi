enum IndexJobKind {
  index
  reindex
  delete

  @@map("index_job_kind")
}

enum IndexJobStatus {
  waiting
  running
  failed

  @@map("index_job_status")
}

/// A request to index, reindex or delete one crate's indexes, or with no crate to delete everything. Migrations add partial unique indexes allowing one waiting, one running and one failed job per crate, and one of each with no crate
model IndexJob {
  id        Int            @id @default(autoincrement())
  crateId   String?
  kind      IndexJobKind
  status    IndexJobStatus @default(waiting)
  attempts  Int            @default(0)
  workerId  String?
  /// What the job is doing (reading the crate, deriving, database index, search index, aggregates), or was doing when it failed
  stage     String?
  /// How much of the stage is done, of `total`, as the worker last saved it
  done      Int?
  total     Int?
  error     String?
  /// The entity or file the job was on when it failed
  failedOn  String?
  createdAt DateTime       @default(now())
  startedAt DateTime?
  failedAt  DateTime?

  crate CrateRecord? @relation(fields: [crateId], references: [id], onDelete: Cascade)

  @@index([crateId])
  @@map("index_job")
}

/// A crate known to be in the repository, and what its last job wrote
model CrateRecord {
  id             String    @id
  name           String?
  indexedVersion Int?
  indexedAt      DateTime?
  entities       Int?
  files          Int?

  jobs  IndexJob[]
  links CrateLink[]

  @@map("crate")
}

/// A worker, or a CLI command working the queue, and when it last showed it was alive
model IndexWorker {
  id          String   @id
  heartbeatAt DateTime @default(now())

  @@map("index_worker")
}
